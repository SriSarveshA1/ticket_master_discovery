# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored -- NEVER commit real keys.

# ----- LLM -----------------------------------------------------------------
# Format is "<provider>:<model>" and is passed to langchain.chat_models.init_chat_model
# Examples: openai:gpt-4o-mini | anthropic:claude-3-5-haiku-latest | google_genai:gemini-2.0-flash
LLM_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key

# ----- External API ---------------------------------------------------------
# Open Library needs no API key. For your assignment you would add:
#   TICKETMASTER_API_KEY=your_key
OPENLIBRARY_BASE_URL=https://openlibrary.org
# Open Library asks API clients to identify themselves in the User-Agent header
OPENLIBRARY_CONTACT=you@example.com

# ----- App -------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
# memory  -> conversations live in RAM (lost on restart)
# sqlite  -> conversations persisted to SQLITE_PATH (needs langgraph-checkpoint-sqlite)
CHECKPOINT_BACKEND=memory
SQLITE_PATH=./sessions.db
LOG_LEVEL=INFO
# Set to true if you see "CERTIFICATE_VERIFY_FAILED" errors (corporate proxy / Zscaler).
USE_SYSTEM_CERTS=false
